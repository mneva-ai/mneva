{
  "manifest_version": 3,
  "name": "mneva",
  "version": "0.1.0",
  "description": "Start every new AI chat with your own mneva profile, read from your computer.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.doubao.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {"default_popup": "popup.html", "default_title": "mneva"},
  "commands": {
    "insert-profile": {
      "suggested_key": {"default": "Alt+Shift+M"},
      "description": "Insert your mneva profile into the focused text field"
    }
  }
}
